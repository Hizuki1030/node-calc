# AIによる計算ブロック設計を使う場合に設定し、このファイルを .env として保存します。
# APIキーはブラウザへ渡さず、Viteのサーバー側からAPIを呼び出す。

# --- パターン1: Claude(Anthropic)に直接つなぐ場合（既定） ---
ANTHROPIC_API_KEY=sk-ant-...
# 必要に応じて利用可能なモデルへ変更できます。
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- パターン2: LiteLLM プロキシ経由など、Claude以外へも振り分ける場合 ---
# AI_API_STYLE=openai
# AI_API_BASE=http://localhost:4000   # LiteLLM プロキシのURL（末尾に /chat/completions は付けない）
# AI_API_KEY=sk-litellm-...           # LiteLLM 側のキー。未設定なら ANTHROPIC_API_KEY を流用する
# AI_MODEL=gpt-4o                     # LiteLLM に登録したモデル名。未設定なら ANTHROPIC_MODEL を流用する
